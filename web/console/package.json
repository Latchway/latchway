{
  "name": "@latchway/admin-console",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "10.15.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build && node scripts/verify-dist.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e",
    "lint": "eslint . --max-warnings=0",
    "preview": "vite preview",
    "test": "vitest run",
    "pretest:e2e": "playwright install --with-deps chromium",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "verify:dist": "node scripts/verify-dist.mjs",
    "verify:reproducible": "node scripts/verify-reproducible.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.102.7",
    "@tanstack/react-router": "1.170.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
