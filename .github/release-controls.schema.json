{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latchway.dev/schemas/github-release-controls.schema.json",
  "title": "Latchway GitHub and npm operational release controls",
  "description": "Desired state for protected release environments and unique policy sentinels, protected main branches, controlled immutable release tags, and npm trusted publishers. It contains names, non-secret policy IDs, and identities, never credential values.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "kind",
    "api_version",
    "control_id",
    "forbidden_secret_names",
    "organization",
    "policy_variable_name",
    "protected_secret_scope",
    "repositories",
    "npm_trusted_publishers"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema_version": { "const": 1 },
    "kind": { "const": "latchway_github_release_controls" },
    "api_version": { "const": "2026-03-10" },
    "control_id": { "const": "latchway-release-controls-v1" },
    "forbidden_secret_names": {
      "const": ["LATCHWAY_SIBLING_REPOSITORIES_READ_TOKEN"]
    },
    "organization": { "const": "Latchway" },
    "policy_variable_name": { "const": "LATCHWAY_RELEASE_CONTROL_POLICY_ID" },
    "protected_secret_scope": { "const": "environment_only" },
    "repositories": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {
          "allOf": [
            { "$ref": "#/$defs/repository" },
            { "properties": { "name": { "const": "latchway" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/repository" },
            { "properties": { "name": { "const": "latchway-js" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/repository" },
            { "properties": { "name": { "const": "latchway-ios-sdk" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/repository" },
            { "properties": { "name": { "const": "latchway-android" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/repository" },
            {
              "properties": {
                "name": { "const": "latchway-react-native-sdk" }
              }
            }
          ]
        }
      ],
      "items": false
    },
    "npm_trusted_publishers": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/npmTrustedPublisher" }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "secretName": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "default_branch", "environments", "rulesets"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "default_branch": { "const": "main" },
        "environments": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/environment" }
        },
        "rulesets": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            { "$ref": "#/$defs/tagRuleset" },
            { "$ref": "#/$defs/branchRuleset" }
          ],
          "items": false
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "policy_id",
        "reviewers",
        "prevent_self_review",
        "deployment",
        "secrets"
      ],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "policy_id": {
          "type": "string",
          "pattern": "^latchway-release-controls-v1:latchway(?:-js|-ios-sdk|-android|-react-native-sdk)?:[a-z0-9][a-z0-9_-]*$"
        },
        "reviewers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "source"],
          "properties": {
            "minimum": { "const": 1 },
            "source": { "const": "command_line" }
          }
        },
        "prevent_self_review": { "const": true },
        "deployment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "branches", "tags"],
          "properties": {
            "mode": { "const": "selected" },
            "branches": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "prefixItems": [{ "const": "main" }],
              "items": false
            },
            "tags": { "type": "array", "maxItems": 0 }
          }
        },
        "secrets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required_names", "allowed_names"],
          "properties": {
            "required_names": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/secretName" }
            },
            "allowed_names": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/secretName" }
            }
          }
        },
        "variables": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required_names", "allowed_names"],
          "properties": {
            "required_names": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/secretName" }
            },
            "allowed_names": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/secretName" }
            }
          }
        }
      }
    },
    "tagRuleset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "target",
        "enforcement",
        "bypass_actors",
        "conditions",
        "rules"
      ],
      "properties": {
        "name": { "const": "latchway-v1-tags-immutable" },
        "target": { "const": "tag" },
        "enforcement": { "const": "active" },
        "bypass_actors": {
          "const": [
            {
              "actor_id": 15368,
              "actor_type": "Integration",
              "bypass_mode": "always"
            }
          ]
        },
        "conditions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ref_name"],
          "properties": {
            "ref_name": {
              "type": "object",
              "additionalProperties": false,
              "required": ["include", "exclude"],
              "properties": {
                "include": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 1,
                  "prefixItems": [{ "const": "refs/tags/v*" }],
                  "items": false
                },
                "exclude": { "type": "array", "maxItems": 0 }
              }
            }
          }
        },
        "rules": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type"],
                "properties": { "type": { "const": "creation" } }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "parameters"],
                "properties": {
                  "type": { "const": "update" },
                  "parameters": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["update_allows_fetch_and_merge"],
                    "properties": {
                      "update_allows_fetch_and_merge": { "const": false }
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type"],
                "properties": { "type": { "const": "deletion" } }
              }
            ]
          }
        }
      }
    },
    "branchRuleset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "target",
        "enforcement",
        "bypass_actors",
        "conditions",
        "rules"
      ],
      "properties": {
        "name": { "const": "latchway-main-protected" },
        "target": { "const": "branch" },
        "enforcement": { "const": "active" },
        "bypass_actors": { "type": "array", "maxItems": 0 },
        "conditions": {
          "const": {
            "ref_name": {
              "include": ["refs/heads/main"],
              "exclude": []
            }
          }
        },
        "rules": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type"],
                "properties": { "type": { "const": "deletion" } }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type"],
                "properties": { "type": { "const": "non_fast_forward" } }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type"],
                "properties": { "type": { "const": "required_linear_history" } }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "parameters"],
                "properties": {
                  "type": { "const": "pull_request" },
                  "parameters": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "allowed_merge_methods",
                      "dismiss_stale_reviews_on_push",
                      "require_code_owner_review",
                      "require_last_push_approval",
                      "required_approving_review_count",
                      "required_review_thread_resolution"
                    ],
                    "properties": {
                      "allowed_merge_methods": {
                        "const": ["squash", "rebase"]
                      },
                      "dismiss_stale_reviews_on_push": { "const": false },
                      "require_code_owner_review": { "const": false },
                      "require_last_push_approval": { "const": false },
                      "required_approving_review_count": { "const": 0 },
                      "required_review_thread_resolution": { "const": true }
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "parameters"],
                "properties": {
                  "type": { "const": "required_status_checks" },
                  "parameters": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "do_not_enforce_on_create",
                      "required_status_checks",
                      "strict_required_status_checks_policy"
                    ],
                    "properties": {
                      "do_not_enforce_on_create": { "const": false },
                      "required_status_checks": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["context", "integration_id"],
                          "properties": {
                            "context": { "type": "string", "minLength": 1 },
                            "integration_id": { "const": 15368 }
                          }
                        }
                      },
                      "strict_required_status_checks_policy": { "const": true }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "npmTrustedPublisher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "provider",
        "repository",
        "workflow",
        "environment",
        "permissions"
      ],
      "properties": {
        "package": { "type": "string", "pattern": "^@latchway/[a-z][a-z0-9-]*$" },
        "provider": { "const": "github" },
        "repository": { "type": "string", "pattern": "^Latchway/[A-Za-z0-9._-]+$" },
        "workflow": { "const": "release.yml" },
        "environment": { "const": "npm" },
        "permissions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "prefixItems": [{ "const": "createPackage" }],
          "items": false
        }
      }
    }
  }
}
