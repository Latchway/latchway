project_id    = "replace-with-project-id"
region        = "asia-southeast1"
service_image                    = "ghcr.io/latchway/latchway@sha256:replace-with-current-service-digest"
migration_image                  = "ghcr.io/latchway/latchway@sha256:replace-with-next-migration-digest"
migration_approved_service_image = "ghcr.io/latchway/latchway@sha256:replace-with-current-service-digest"
service_revision_name            = "latchway-release-id"
previous_service_revision_name   = null
service_traffic_percent          = 100
public_origin                    = "https://ai.example.com"

min_instances               = 1
max_instances               = 10
db_connections_per_instance = 20
inject_admin_bootstrap_token = true
migrate_on_start             = true
