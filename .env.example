# Local development values only. Generate production values independently.
POSTGRES_DB=latchway
POSTGRES_USER=latchway
POSTGRES_PASSWORD=latchway-local-development
LATCHWAY_DATABASE_URL=postgres://latchway:latchway-local-development@postgres:5432/latchway?sslmode=disable
LATCHWAY_ROLE=all
LATCHWAY_LOG_LEVEL=info
LATCHWAY_PUBLIC_ORIGIN=http://localhost:8080
# Required and intentionally not populated here. Generate this once with
# `openssl rand -base64 32`, append it to the untracked `.env`, and keep it
# stable for the lifetime of that database.
# LATCHWAY_MASTER_KEY=<base64-encoded-32-byte-random-key>
# Required only until the first owner exists. Generate a fresh 32+ byte value
# before the first server start; never boot a new database with a public default.
# LATCHWAY_ADMIN_BOOTSTRAP_TOKEN=<one-use-random-bootstrap-token>
LATCHWAY_ADMIN_SESSION_LIFETIME=12h
PORT=8080
