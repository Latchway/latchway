{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latchway.dev/schemas/test-vectors/0.5.0/dpop-vector-set.schema.json",
  "title": "Latchway RFC 9449 DPoP vector set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "contract_version",
    "wire_protocol_version",
    "reference_time",
    "maximum_iat_skew_seconds",
    "fixture_access_token",
    "fixture_access_token_hash",
    "public_jwk",
    "private_jwk_for_tests_only",
    "jwk_thumbprint_canonical_json",
    "jwk_thumbprint_sha256_base64url",
    "vectors"
  ],
  "properties": {
    "format_version": { "type": "integer", "const": 1 },
    "contract_version": { "type": "string", "const": "0.5.0" },
    "wire_protocol_version": { "type": "integer", "const": 1 },
    "reference_time": { "type": "integer", "minimum": 0 },
    "maximum_iat_skew_seconds": { "type": "integer", "minimum": 0, "maximum": 300 },
    "fixture_access_token": { "type": "string", "minLength": 16 },
    "fixture_access_token_hash": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
    "public_jwk": { "$ref": "#/$defs/PublicJWK" },
    "private_jwk_for_tests_only": { "$ref": "#/$defs/PrivateJWK" },
    "jwk_thumbprint_canonical_json": { "type": "string", "minLength": 2 },
    "jwk_thumbprint_sha256_base64url": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Vector" }
    }
  },
  "$defs": {
    "PublicJWK": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kty", "crv", "x", "y"],
      "properties": {
        "kty": { "const": "EC" },
        "crv": { "const": "P-256" },
        "x": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
        "y": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" }
      }
    },
    "PrivateJWK": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kty", "crv", "x", "y", "d"],
      "properties": {
        "kty": { "const": "EC" },
        "crv": { "const": "P-256" },
        "x": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
        "y": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
        "d": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" }
      }
    },
    "Vector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "purpose", "proof", "request", "expected"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,127}$" },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 512 },
        "proof": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
        },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "uri"],
          "properties": {
            "method": { "type": "string", "pattern": "^[A-Z]+$" },
            "uri": { "type": "string", "format": "uri", "pattern": "^https://" },
            "use_fixture_access_token": { "type": "boolean", "default": false },
            "required_nonce": { "type": "string", "minLength": 1 },
            "proof_jti_already_seen": { "type": "boolean", "default": false }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["valid"],
          "properties": {
            "valid": { "type": "boolean" },
            "error_code": { "type": "string", "enum": ["dpop_invalid", "dpop_replayed", "dpop_nonce_required"] }
          },
          "allOf": [
            {
              "if": { "properties": { "valid": { "const": false } }, "required": ["valid"] },
              "then": { "required": ["error_code"] }
            }
          ]
        }
      }
    }
  }
}
