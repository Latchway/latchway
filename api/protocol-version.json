{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "manifest_version": 1,
  "contract_version": "1.1.1",
  "client_contract_version": "1.1.0",
  "contract_status": "released",
  "released_at": "2026-09-08T15:11:31Z",
  "wire_protocol": {
    "current": 3,
    "supported": [1, 2, 3],
    "minimum": 1
  },
  "bundle": {
    "file_name": "latchway-contract-1.1.1.tar.gz",
    "required_entries": [
      "client.openapi.yaml",
      "admin.openapi.yaml",
      "config.schema.json",
      "attestation-binding.schema.json",
      "component-attestation-binding.schema.json",
      "release-evidence.schema.json",
      "error-codes.yaml",
      "sdk-error-codes.yaml",
      "protocol-version.json",
      "compatibility",
      "test-vectors",
      "SHA256SUMS"
    ]
  },
  "dpop": {
    "specification": "RFC 9449",
    "jwk_thumbprint_specification": "RFC 7638",
    "algorithms": ["ES256"],
    "curves": ["P-256"],
    "proof_type": "dpop+jwt"
  },
  "attestation_binding": {
    "version": 1,
    "canonicalization": "RFC 8785 JCS",
    "hash": "SHA-256"
  },
  "component_attestation_binding": {
    "version": 2,
    "purpose": "component_attestation_step_up",
    "canonicalization": "RFC 8785 JCS",
    "hash": "SHA-256"
  },
  "release_evidence": {
    "schema_file": "release-evidence.schema.json",
    "schema_version": 1,
    "maximum_age_seconds": 604800,
    "maximum_window_seconds": 604800,
    "promotion_domains": [
      "live_sdk_conformance",
      "physical_devices",
      "live_provider",
      "cloud_deployments",
      "operational_resilience",
      "supply_chain"
    ],
    "release_domains": [
      "live_sdk_conformance",
      "public_tags",
      "public_registries",
      "physical_devices",
      "live_provider",
      "cloud_deployments",
      "operational_resilience",
      "supply_chain"
    ]
  },
  "standard_headers": {
    "feature": "X-Latchway-Feature",
    "sdk": "X-Latchway-SDK",
    "sdk_version": "X-Latchway-SDK-Version",
    "caller": "X-Latchway-Caller",
    "framework": "X-Latchway-Framework",
    "framework_version": "X-Latchway-Framework-Version",
    "protocol_version": "X-Latchway-Protocol-Version",
    "request_id": "X-Latchway-Request-ID"
  },
  "sdk_kinds": ["ios", "android", "javascript", "react-native", "native"],
  "capabilities": {
    "supplied_identity_v1": {
      "minimum_protocol": 3,
      "identity_verification_endpoint": "/client/v1/sessions/identity",
      "authorization": "active_refresh_token_and_dpop",
      "rotates_credentials": false
    }
  }
}
